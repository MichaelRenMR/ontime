DATABASE_URL=postgresql+psycopg://ontime:ontime@localhost:5432/ontime
RAW_STORE_URL=file://./data/raw
CORS_ORIGINS=http://localhost:3000

# AeroDataBox. Defaults target RapidAPI; override these for API.Market or a direct plan.
ADB_API_KEY=
ADB_BASE_URL=https://aerodatabox.p.rapidapi.com
ADB_KEY_HEADER=X-RapidAPI-Key
ADB_HOST_HEADER=X-RapidAPI-Host
ADB_HOST_VALUE=aerodatabox.p.rapidapi.com

PROVIDER_DAILY_UNIT_CAP=5000
PROVIDER_MAX_CONCURRENCY=2
