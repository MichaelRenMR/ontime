DATABASE_URL=postgresql+psycopg://ontime:ontime@localhost:5432/ontime
RAW_STORE_URL=file://./data/raw
CORS_ORIGINS=http://localhost:3000

# AeroDataBox direct API key (sent as the X-Api-Key header to https://api.aerodatabox.com)
ADB_API_KEY=

# Quota guards, checked before every provider call. Sized for the direct Starter plan (40,000 units/month).
PROVIDER_DAILY_UNIT_CAP=1000
PROVIDER_MONTHLY_UNIT_CAP=36000
PROVIDER_MONTHLY_REQUEST_CAP=0
PROVIDER_MAX_CONCURRENCY=2
